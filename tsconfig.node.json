{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    /**
     * Build tooling ONLY (vite.config.ts, scripts/*).
     *
     * Kept separate so Node globals — `process`, `node:fs`, `__dirname` — are
     * available to config files without leaking into the browser bundle's type
     * space, where referencing them would compile but fail at runtime.
     */
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true
  },
  "include": ["vite.config.ts", "scripts/**/*.mjs"]
}
