{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* composite + tsBuildInfoFile: required for the project references in
       tsconfig.json, and gives incremental typechecks. */
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.client.tsbuildinfo",
    /** Browser-side ONLY — DOM types here, never Workers types. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts"]
}
